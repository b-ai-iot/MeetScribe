{
  "name": "meetscribe",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.cjs",
    "test:extension": "node tests/extension-smoke.cjs",
    "package": "python3 tools/package.py",
    "docs:check": "python3 tools/check_docs.py",
    "docs:screenshots": "node tools/screenshots.cjs"
