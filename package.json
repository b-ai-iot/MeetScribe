  "repository": {
    "type": "git",
    "url": "git+https://github.com/b-ai-iot/MeetScribe.git"
  },
  "homepage": "https://github.com/b-ai-iot/MeetScribe#readme",
  "bugs": {
    "url": "https://github.com/b-ai-iot/MeetScribe/issues"
  }
