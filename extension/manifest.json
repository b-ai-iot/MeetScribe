{
  "manifest_version": 3,
  "name": "MeetScribe — Ghi chú cuộc họp",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "description": "Thu caption và ảnh chia sẻ trên Google Meet / Zoom web. Thanh nổi, lưu cục bộ vào Downloads, không gọi AI khi họp.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen",
    "downloads",
    "alarms",
    "unlimitedStorage",
    "storage"
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "MeetScribe · Mở thanh ghi họp"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
